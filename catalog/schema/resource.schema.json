{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplelearningresources.com/schemas/resource.schema.json",
  "title": "Learning Made Simple resource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "status",
    "routing",
    "publication",
    "title",
    "description",
    "learningFocus",
    "taxonomy",
    "keywords",
    "pages",
    "assets",
    "seo",
    "source",
    "ordering",
    "legacy"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {"enum": ["draft", "review", "published", "retired"]},
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "aliases"],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publishedAt", "updatedAt"],
      "properties": {
        "publishedAt": {"type": ["string", "null"], "format": "date"},
        "updatedAt": {"type": ["string", "null"], "format": "date"}
      }
    },
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "learningFocus": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "adultGuidance": {"type": "string", "minLength": 1},
    "language": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
    "resourceType": {"enum": ["worksheet", "worksheet-pack"]},
    "relatedResources": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade", "subject", "topic", "skills"],
      "properties": {
        "grade": {"type": "string"},
        "subject": {"type": "string"},
        "topic": {"type": "string"},
        "skills": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "keywords": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "previewAlt": {"type": "string", "minLength": 1}
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundlePdf", "pagePdfDirectory", "previewDirectory", "preview"],
      "properties": {
        "bundlePdf": {"type": "string"},
        "pagePdfDirectory": {"type": "string"},
        "previewDirectory": {"type": "string"},
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "dpi", "format"],
          "properties": {
            "width": {"const": 1224},
            "height": {"const": 1584},
            "dpi": {"const": 144},
            "format": {"const": "png"}
          }
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "socialImage": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "publisherContract", "generatorConfig"],
      "properties": {
        "type": {"enum": ["generated", "approved-bundle"]},
        "publisherContract": {"type": "string"},
        "generatorConfig": {"type": ["string", "null"]}
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog", "withinTopic"],
      "properties": {
        "catalog": {"type": "integer", "minimum": 1},
        "withinTopic": {"type": "integer", "minimum": 1}
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previewHref", "backHref", "backLabel"],
      "properties": {
        "previewHref": {"type": "string"},
        "backHref": {"type": "string"},
        "backLabel": {"type": "string"}
      }
    },
    "retiredReason": {"type": "string"}
  }
}
